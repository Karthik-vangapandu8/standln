# ─── Telegram Bot ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=your_bot_username_here

# The class passcode classmates must send once to unlock the bot
CLASS_PASSCODE=YOUR_PASSCODE_HERE

# Your numeric Telegram chat ID (send /whoami to the bot to get it)
CR_CHAT_ID=your_chat_id_here

# ─── ElevenLabs ─────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_cloned_voice_id_here

# ─── Ollama (local Gemma) ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ─── Google Drive ────────────────────────────────────────────
# Link to your class root Google Drive folder
DRIVE_HUB_URL=your_drive_folder_url_here

# ─── Optional ────────────────────────────────────────────────
PORT=3000
VOICE_DAILY_CAP=15
REQUEST_COOLDOWN_MS=4000
